####### Compile

debug/main.o: ../../main.cpp ../../mainwindow.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o debug\main.o ..\..\main.cpp

debug/mainwindow.o: ../../mainwindow.cpp ../../mainwindow.h \
		ui_mainwindow.h \
		../../capturethread.h \
		../../framesource.h \
		../../displaythread.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o debug\mainwindow.o ..\..\mainwindow.cpp

debug/capturethread.o: ../../capturethread.cpp ../../capturethread.h \
		../../framesource.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o debug\capturethread.o ..\..\capturethread.cpp

debug/displaythread.o: ../../displaythread.cpp ../../displaythread.h \
		../../framesource.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o debug\displaythread.o ..\..\displaythread.cpp

debug/moc_mainwindow.o: debug/moc_mainwindow.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o debug\moc_mainwindow.o debug\moc_mainwindow.cpp

debug/moc_capturethread.o: debug/moc_capturethread.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o debug\moc_capturethread.o debug\moc_capturethread.cpp

debug/moc_displaythread.o: debug/moc_displaythread.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o debug\moc_displaythread.o debug\moc_displaythread.cpp

